---
import Base from '../../layouts/Base.astro';
import Ornament from '../../components/Ornament.astro';
import DiagramPlate from '../../components/DiagramPlate.astro';
import { products, type Product } from '../../data/projects';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
---

<Base
  title={`${product.name} — Volodymyr Pavlyshyn`}
  description={`${product.name}: ${product.summary}`}>

  <div class="page">
    <p class="crumb meta"><a href="/projects">Projects</a> · open source</p>

    <section class="product">
      <div class="product-text">
        <h1 class="display">{product.name}</h1>
        <p class="standfirst">{product.tagline}</p>
        {product.body.map((para) => <p>{para}</p>)}
        <p class="product-links">
          <a class="btn btn-solid" href={product.home.href}>{product.home.label}</a>
          {product.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </p>
      </div>
      <div class="product-plate">
        <DiagramPlate kind={product.plate} />
      </div>
    </section>

    <Ornament />

    <section>
      <h2 class="section-title">What it does</h2>
      <dl class="points">
        {product.points.map((p) => (
          <div>
            <dt>{p.label}</dt>
            <dd>{p.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    {product.sample && (
      <section>
        <h2 class="section-title">In a terminal</h2>
        <figure class="sample">
          <pre><code>{product.sample.code}</code></pre>
          <figcaption><code>$ {product.sample.caption}</code></figcaption>
        </figure>
      </section>
    )}

    <p class="back"><a href="/projects">← All projects</a></p>
  </div>
</Base>

<style>
  .crumb { margin: 2.6rem 0 0; }
  .crumb a { color: var(--ink-faded); text-decoration: none; }
  .crumb a:hover { color: var(--orange); }

  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: 2.6rem 3.5rem;
    align-items: start;
    margin-top: 1.2rem;
  }
  @media (max-width: 52rem) { .product { grid-template-columns: 1fr; } }
  .product-plate { padding-top: 1.2rem; }

  .product-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
    margin-top: 1.8rem;
    font-size: 0.85rem;
  }
  .product-links a:not(.btn) {
    font-variant: small-caps;
    letter-spacing: 0.11em;
    text-transform: lowercase;
    text-decoration: none;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1.6rem 2.4rem;
    margin: 0;
  }
  .points dt {
    font-variant: small-caps;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--orange);
  }
  .points dd { margin: 0.2rem 0 0; font-size: 0.93rem; color: var(--ink-faded); }

  .sample { margin: 0; }
  .sample pre {
    margin: 0;
    padding: 1.2rem 1.4rem;
    background: var(--paper-deep);
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .sample figcaption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--ink-faded);
    overflow-wrap: anywhere;
  }

  .back { margin-top: 3rem; font-size: 0.95rem; }
</style>
