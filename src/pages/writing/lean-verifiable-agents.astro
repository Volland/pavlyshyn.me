    margin-top: 2rem;
    font-variant: small-caps;
    letter-spacing: 0.07em;
    text-transform: lowercase;
    color: var(--orange);
  }
  .essay :not(pre) > code { font-size: 0.88em; background: var(--paper-deep); padding: 0.05em 0.3em; }

  .code { margin: 1.6rem 0; }
  .code pre {
    margin: 0;
    padding: 1.1rem 1.3rem;
    background: var(--paper-deep);
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.55;
  }
