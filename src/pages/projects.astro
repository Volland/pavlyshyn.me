---
import Base from '../layouts/Base.astro';
import Ornament from '../components/Ornament.astro';
import DiagramPlate from '../components/DiagramPlate.astro';
import { tools, products, research, thesis } from '../data/projects';

const memory = [...products.filter((p) => p.group === 'memory')].sort(
  (a, b) => (b.slug === 'typedgraph' ? 1 : 0) - (a.slug === 'typedgraph' ? 1 : 0),
);
const tooling = products.filter((p) => p.group === 'tooling');
---

<Base
  title="Projects — Volodymyr Pavlyshyn"
  description="Open-source memory for agents and humans — TypedGraph, Tiramemsu, OxigraphDB — plus Factum ORM, LPG Modeler and Causal Canvas, three VS Code tools where you draw the model and ship the text.">

  <div class="page">
    <header class="head">
      <h1 class="display">Memory for agents and humans.</h1>
      <p class="standfirst">
        My open-source work, in two lines: <a href="#memory">memory systems</a> — the
        shared spaces where agents and people keep context and exchange knowledge — and
        <a href="#modeling">modelling tools</a> for drawing a domain and shipping it as text.
      </p>
    </header>

    <Ornament />

    <section id="memory">
      <h2 class="section-title">Memory &amp; agents</h2>
      <p class="standfirst">
        Open-source memory for agents and the teams around them: a shared graph that
        people and agents write together, a database that never forgets what it learned
        or when, and memory that stays on the device. The research behind it is on the
        <a href="/papers">Papers</a> page.
      </p>
      <div class="memory-list">
        {memory.map((p) => (
          <section class="tool" id={p.slug}>
            <div class="tool-plate">
              <DiagramPlate kind={p.plate} />
            </div>
            <div class="tool-body">
              <h3 class="tool-name"><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
              <p class="tool-tagline">{p.tagline}</p>
              <p class="tool-text">{p.summary}</p>
              <p class="tool-links">
                <a class="btn" href={`/projects/${p.slug}`}>About {p.name}</a>
                <a href={p.home.href}>{p.home.href.replace(/^https:\/\//, '').replace(/\/$/, '')}</a>
              </p>
            </div>
          </section>
        ))}
      </div>
    </section>

    <Ornament />

    <header class="head sub" id="modeling">
      <h2 class="section-title">{thesis.headline}</h2>
      <p class="standfirst">{thesis.body}</p>
    </header>

    {tools.map((tool, i) => (
      <section class="tool" id={tool.slug}>
        <div class="tool-plate">
          <DiagramPlate kind={tool.plate} />
        </div>
        <div class="tool-body">
          <h2 class="tool-name">{tool.name}</h2>
          <p class="tool-tagline">{tool.tagline}</p>
          <p class="tool-text" set:html={tool.body
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.+?)\*/g, '<em>$1</em>')} />
          <p class="tool-links">
            <a class="btn" href={tool.marketplace}>Install</a>
            <a href={tool.docs}>Documentation</a>
            <a href={tool.repo}>Source</a>
          </p>
        </div>
      </section>
    ))}

    <Ornament />

    <section id="open-source">
      <h2 class="section-title">Graph tooling</h2>
      <p class="standfirst">
        A way to prove a property graph still matches its model, built in the open.
      </p>
      <div class="products">
        {tooling.map((p) => (
          <article class="product">
            <h3 class="tool-name"><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
            <p class="tool-tagline">{p.tagline}</p>
            <p class="product-summary">{p.summary}</p>
            <p class="tool-links">
              <a class="btn" href={`/projects/${p.slug}`}>About {p.name}</a>
              <a href={p.home.href}>{p.home.href.replace(/^https:\/\//, '').replace(/\/$/, '')}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <Ornament />

    <section>
      <h2 class="section-title">Research &amp; reference</h2>
      <p class="standfirst">
        Libraries, reference implementations and research — smaller than the tools
        above, kept public because the results are more useful in the open.
      </p>
      <ul class="repos">
        {research.map((r) => (
          <li>
            <a class="repo-name" href={r.href}>{r.name}</a>
            {r.stars ? <span class="stars">{r.stars}★</span> : null}
            <p>{r.body}</p>
            {r.links && (
              <p class="repo-links">
                {r.links.map((l) => <a href={l.href}>{l.label}</a>)}
              </p>
            )}
          </li>
        ))}
      </ul>
      <p class="more-repos">
        There is a good deal more at <a href="https://github.com/Volland">github.com/Volland</a>
        — ontology editors, graph engines, and a quantity of half-finished ideas.
      </p>
    </section>
  </div>
</Base>

<style>
  .head { margin: 3.4rem 0 0; }
  .head .display { max-width: 18ch; }
  .head.sub { margin-top: 0; }
  .memory-list { margin-top: 1rem; }

  .tool {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 2.6rem;
    align-items: start;
    padding: 2.6rem 0;
    border-top: 1px solid var(--rule);
  }
  .tool:first-of-type { border-top: 0; }
  @media (max-width: 50rem) { .tool { grid-template-columns: 1fr; gap: 1.4rem; } }

  .tool-name a { color: var(--ink); text-decoration: none; }
  .tool-name a:hover { color: var(--orange); }
  .tool-name {
    font-size: 1.7rem;
    font-variant: small-caps;
    letter-spacing: 0.07em;
    text-transform: lowercase;
    margin-bottom: 0.1em;
  }
  .tool-tagline { font-size: 1.1rem; color: var(--orange); margin-bottom: 0.8em; }
  .tool-text { max-width: 38rem; }
  .tool-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.4rem;
    font-size: 0.85rem;
  }
  .tool-links a:not(.btn) {
    font-variant: small-caps;
    letter-spacing: 0.11em;
    text-transform: lowercase;
    text-decoration: none;
  }

  .products {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 1.6rem;
  }
  .product { padding: 0.4rem 2.4rem 0.6rem 0; }
  @media (max-width: 46rem) {
    .products { grid-template-columns: 1fr; }
    .product { padding: 0 0 1.8rem; }
  }
  .product .tool-name a { color: var(--ink); text-decoration: none; }
  .product .tool-name a:hover { color: var(--orange); }
  .product-summary { color: var(--ink-faded); font-size: 0.95rem; }
  .product .tool-links { flex-wrap: wrap; }

  .repos { list-style: none; padding: 0; margin: 1.6rem 0 0; }
  .repos li { padding: 0.9rem 0; border-top: 1px solid var(--rule); }
  .repo-name {
    font-variant: small-caps;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    text-decoration: none;
    font-size: 1.05rem;
  }
  .stars { color: var(--ink-faded); font-size: 0.8rem; margin-left: 0.6rem; }
  .repos p { margin: 0.2rem 0 0; color: var(--ink-faded); font-size: 0.92rem; max-width: 42rem; }
  .repos .repo-links { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 0.4rem; font-size: 0.8rem; }
  .repo-links a {
    font-variant: small-caps;
    letter-spacing: 0.11em;
    text-transform: lowercase;
    text-decoration: none;
  }
  .more-repos { margin-top: 1.6rem; font-size: 0.9rem; color: var(--ink-faded); }
</style>
