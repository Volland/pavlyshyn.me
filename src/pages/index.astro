---
import Base from '../layouts/Base.astro';
import Ornament from '../components/Ornament.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import { books } from '../data/books';
import { tools, products } from '../data/projects';
import { papers } from '../data/papers';
import { offers } from '../data/services';
import { site } from '../data/site';

const published = books.filter((b) => !b.inProgress).length;
const memory = products.filter((p) => p.group === 'memory');
const featured = memory.find((p) => p.slug === 'typedgraph')!;
const others = memory.filter((p) => p !== featured);
---

<Base
  title="Volodymyr Pavlyshyn — Principal Engineer & Architect for agent memory"
  description="Principal engineer and architect for AI agent memory: knowledge graphs, retrieval, temporal and verifiable data, agent identity and trust. Twice a founding engineer. Architecture consulting, reviews and workshops from Berlin.">

  <div class="page">
    <section class="hero">
      <div class="hero-text">
        <p class="meta hero-role">Principal engineer &amp; architect</p>
        <h1 class="display">Memory for agents and&nbsp;humans.</h1>
        <p class="standfirst">
          I design how AI agents and the teams around them remember — knowledge graphs,
          retrieval, temporal and verifiable data, and the identity and trust between
          agents — and I have shipped it in production, not just on slides.
        </p>
        <p class="standfirst">
          Engineering since 2002. Founding engineer twice over — at Affinidi, on
          self-sovereign identity, and at Mykin, on a privacy-first personal AI with its
          memory on the device. Before that, architecture at Zalando scale.
        </p>
        <p class="hero-actions" aria-label="Explore the work">
          <a class="btn btn-solid" href="/services">Work with me</a>
          <a class="btn" href="/cv">See the experience</a>
        </p>
      </div>

      <figure class="frontispiece">
        <div class="oval">
          <img src="/portrait.jpg" width="640" height="640" alt="Volodymyr Pavlyshyn" />
        </div>
        <figcaption>Volodymyr Pavlyshyn<br />Berlin · anno mmxxvi</figcaption>
      </figure>
    </section>

    <Ornament />

    <!-- The Two Doors: a hire path and a reader path, as peers (see ADR 0004). -->
    <section class="doors" aria-label="Where to go next">
      <div class="door">
        <h2 class="door-title">Work with me</h2>
        <p>
          Architecture consulting on agent memory, knowledge graphs, and agent identity
          and trust: design partnership, architecture reviews and team workshops — the
          same problems the books are about, on your system.
        </p>
        <p class="door-list">
          {offers.map((o) => <span>{o.name}</span>)}
        </p>
        <a class="btn btn-solid" href="/services">Explore the services</a>

        <div class="evidence">
          <span class="meta">Tools I have shipped</span>
          <p>
            {tools.map((t, i) => (
              <>
                <a href={`/projects#${t.slug}`}>{t.name}</a>{' · '}
              </>
            ))}
            {products.map((p, i) => (
              <>
                {i > 0 && ' · '}<a href={`/projects/${p.slug}`}>{p.name}</a>
              </>
            ))}
          </p>
        </div>
      </div>
      <div class="door">
        <h2 class="door-title">Read the work</h2>
        <p>
          {published} published books on agentic memory, graph substrates, and what an
          agent needs in order to remember — plus tea, yerba mate, and one techno-horror
          novella.
        </p>
        <p class="door-list">
          {books.filter((b) => b.shelf === 'agents-graphs' && !b.inProgress).slice(0, 4).map((b) => (
            <span>{b.title}</span>
          ))}
          <span class="more">…and {published - 4} more</span>
        </p>
        <a class="btn" href="/books">Browse the catalogue</a>
      </div>

    </section>

    <Ornament />

    <section class="memory" aria-labelledby="memory-title">
      <h2 class="section-title" id="memory-title">Open-source memory for agents and humans</h2>
      <div class="memory-grid">
        <article class="memory-lead">
          <h3 class="memory-name"><a href={`/projects/${featured.slug}`}>{featured.name}</a></h3>
          <p class="memory-tag">{featured.tagline}</p>
          <p>{featured.summary} A shared space where people and their agents work from the same graph.</p>
          <p class="memory-links">
            <a class="btn btn-solid" href={featured.home.href}>Visit typedgraph.org</a>
            <a href={`/projects/${featured.slug}`}>About {featured.name}</a>
          </p>
        </article>
        <div class="memory-rest">
          {others.map((p) => (
            <article>
              <h3 class="memory-name small"><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
              <p class="memory-tag">{p.tagline}</p>
              <p>{p.summary}</p>
            </article>
          ))}
        </div>
      </div>
      <p class="memory-foot">
        <a href="/projects#memory">All memory projects →</a>
        <span>Independent research behind them: {papers.map((p, i) => (<>{i > 0 && ' · '}<a href="/papers">{p.title.split(':')[0]}</a></>))}</span>
      </p>
    </section>

    <Ornament />

    <section class="experience" aria-labelledby="experience-title">
      <h2 class="section-title" id="experience-title">From architecture to production</h2>
      <div class="experience-grid">
        <article>
          <h3>Mykin · memory on the device</h3>
          <p>Founding engineer and principal architect. Shaped the technical vision with
            the CTO and built on-device semantic memory for a privacy-first personal AI —
            a personal knowledge graph with vector search and clustering, running on a
            phone. Partnered with Turso to bring vector search to mobile, and represented
            the architecture in a $2M round.</p>
        </article>
        <article>
          <h3>Affinidi · identity people could use</h3>
          <p>Founding engineer, architecture group and Office of CTO. Led cross-company
            architecture reviews, introduced ADRs and C4 across engineering, and took a
            COVID verifiable-credentials platform from zero to a live airport
            integration in four weeks.</p>
        </article>
        <article>
          <h3>Zalando · architecture at scale</h3>
          <p>Architected and led Transaction Core, the order backend for 40M+ customers;
            led the checkout monolith's move to microservices and co-ordinated 18 teams,
            about 100 engineers, for the loyalty-programme rollout.</p>
        </article>
      </div>
      <ImpactStrip />
      <p class="experience-foot"><a href="/cv">Read the full CV →</a></p>
    </section>

    <Ornament />

    <section class="plate-band">
      <figure class="plate">
        <img
          src="/engravings/llull-ars-magna-wheel.jpg"
          width="1000" height="1000" loading="lazy"
          alt="Figura A from Ramon Llull's Ars Magna, 1305: nine concepts arranged on a wheel, every one joined to every other." />
        <figcaption>
          Ramon Llull, <em>Ars Magna</em>, 1305. Nine concepts on a wheel, every one
          joined to every other — a complete graph, drawn seven centuries before anyone
          needed the word.
        </figcaption>
      </figure>
      <div>
        <h2 class="section-title">Also here</h2>
        <dl class="index">
          <dt><a href="/projects">Projects</a></dt>
          <dd>Open-source memory for agents and humans — TypedGraph, Tiramemsu, OxigraphDB — plus shacl2cypher and three VS Code modelling tools: Factum ORM, LPG Modeler, Causal Canvas.</dd>
          <dt><a href="/papers">Papers</a></dt>
          <dd>Independent research on bitemporal graphs, statement identity and metagraph encodings, on Zenodo.</dd>
          <dt><a href="/kids">Children's books</a></dt>
          <dd>Max and Tsugi — a cycle for Ukrainian children about living with cerebral palsy.</dd>
          <dt><a href="/cv">CV</a></dt>
          <dd>2002 to now, filterable, with the PDF.</dd>
          <dt><a href="/writing">Writing</a></dt>
          <dd>Substack, YouTube, Medium — the latest of each.</dd>
        </dl>
        <p class="contact-line">
          Or write to me: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem 3.5rem;
    align-items: start;
    margin: 3.6rem 0 0;
  }
  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; }
    .frontispiece { width: 11rem; margin: 0 auto; }
  }
  .hero-text .display { max-width: 15ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.4rem 0 1.8rem; max-width: none; }
  .memory-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.6rem; margin-top: 1.2rem; }
  @media (max-width: 46rem) { .memory-grid { grid-template-columns: 1fr; gap: 1.6rem; } }
  .memory-name { font-size: 1.9rem; font-variant: small-caps; letter-spacing: 0.07em; text-transform: lowercase; margin-bottom: 0.1em; }
  .memory-name.small { font-size: 1.3rem; }
  .memory-name a { color: var(--ink); text-decoration: none; }
  .memory-name a:hover { color: var(--orange); }
  .memory-tag { color: var(--orange); margin-bottom: 0.5em; }
  .memory-rest article + article { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); }
  .memory-rest p:not(.memory-tag) { font-size: 0.93rem; color: var(--ink-faded); }
  .memory-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; margin-top: 1.2rem; font-size: 0.85rem; }
  .memory-links a:not(.btn) { font-variant: small-caps; letter-spacing: 0.11em; text-transform: lowercase; text-decoration: none; }
  .memory-foot { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; margin-top: 1.8rem; font-size: 0.9rem; color: var(--ink-faded); max-width: none; }
  .experience-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.4rem; }
  @media (max-width: 60rem) { .experience-grid { grid-template-columns: 1fr 1fr; } }
  .experience-foot { margin-top: 1.4rem; }
  .hero-role { display: block; margin-bottom: 0.6rem; color: var(--orange); }
  .experience h3 { font-size: 1.2rem; }
  .experience p { font-size: 0.95rem; color: var(--ink-faded); }
  @media (max-width: 46rem) { .experience-grid { grid-template-columns: 1fr; gap: 1rem; } }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .door { padding: 0.4rem 2.4rem 0.6rem 0; }
  .door + .door {
    padding: 0.4rem 0 0.6rem 2.4rem;
    border-left: 1px solid var(--rule);
  }
  @media (max-width: 46rem) {
    .doors { grid-template-columns: 1fr; }
    .door { padding: 0 0 1.8rem; }
    .door + .door { padding: 1.8rem 0 0; border-left: 0; border-top: 1px solid var(--rule); }
  }
  .door-title {
    font-size: 1.5rem;
    font-variant: small-caps;
    letter-spacing: 0.09em;
    text-transform: lowercase;
  }
  .door p { max-width: 30rem; }
  .door-list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.9rem;
    color: var(--ink-faded);
    margin-bottom: 1.3rem;
  }
  .door-list .more { font-style: italic; }

  .evidence { margin-top: 1.8rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .evidence p { margin: 0.25rem 0 0; font-size: 0.95rem; }

  .plate-band {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: 2.6rem;
    align-items: start;
  }
  @media (max-width: 46rem) { .plate-band { grid-template-columns: 1fr; } }
  .plate-band figure { margin: 0; }
  .plate-band figcaption {
    font-size: 0.82rem;
    color: var(--ink-faded);
    margin-top: 0.8rem;
    line-height: 1.5;
  }

  .index { margin: 0; }
  .index dt { margin-top: 0.9rem; }
  .index dt a {
    font-variant: small-caps;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    text-decoration: none;
  }
  .index dd { margin: 0.05rem 0 0; color: var(--ink-faded); font-size: 0.95rem; }
  .contact-line { margin-top: 2rem; font-size: 0.95rem; }
</style>
