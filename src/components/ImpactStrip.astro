---
import { impact } from '../data/cv';

interface Props {
  title?: string;
}

const { title = 'Selected impact' } = Astro.props;
---

<section class="impact" aria-label={title}>
  <h2 class="meta impact-title">{title}</h2>
  <dl class="impact-grid">
    {impact.map((i) => (
      <div>
        <dt>{i.figure}</dt>
        <dd>{i.body}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .impact { margin: 2.4rem 0 0; }
  .impact-title { display: block; margin-bottom: 0.8rem; }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.4rem;
    margin: 0;
    padding: 1.2rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 52rem) { .impact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .impact-grid { grid-template-columns: 1fr; } }
  .impact dt {
    font-size: 1.7rem;
    color: var(--orange);
    line-height: 1.1;
    font-variant-numeric: oldstyle-nums;
  }
  .impact dd { margin: 0.3rem 0 0; font-size: 0.85rem; color: var(--ink-faded); line-height: 1.4; }
</style>
